# TasteMaker - Environment Variables
# Copy to .env and fill in your values

# Apify (Pinterest scraping)
APIFY_TOKEN=apify_api_xxxxxxxxxxxxx
# Optional: override default Pinterest actor (pay-per-use, no rental)
# APIFY_PINTEREST_ACTOR=headlessagent/pinterest-board-downloader

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxx...
# Or use anon key: SUPABASE_KEY=eyJxxx...

# Anthropic (Claude analysis)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Access password (required when deployed; any username works in the browser prompt)
# Leave unset for local-only use: then only requests from this machine are allowed.
# TASTEMAKER_PASSWORD=choose-a-long-passphrase
